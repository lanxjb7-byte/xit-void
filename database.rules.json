{
  "rules": {
    "keys": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['role','active']) || !newData.exists()"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
